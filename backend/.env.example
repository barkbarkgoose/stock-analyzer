SECRET_KEY=change-me-in-production
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5177
DATABASE_URL=sqlite:///db.sqlite3

# Optional: Fernet key used to encrypt user-provided secrets at rest.
# When unset, apps/users/crypto.py falls back to keychain.key, then derives a
# key from SECRET_KEY. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SETTINGS_ENCRYPTION_KEY=

# --- Market research ---
# auto prefers Alpaca when keys are present, otherwise Yahoo.
MARKET_PROVIDER=auto
# CSV provider path (optional)
# MARKET_CSV_PATH=/absolute/path/to/bars.csv
ALPACA_FEED=iex
ALPACA_ADJUSTMENT=all
MARKET_DEFAULT_NOTIONAL=10000
