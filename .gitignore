# --- agent pending ---
# ignore the whole directory (anchored at repo root)
.agent-tasks/
.agent-tasks/**

# --- unignore archive ---
# allow Git to traverse into .agent-pending and archive
!/.agent-tasks/
!/.agent-tasks/archive/
!/.agent-tasks/archive/**

# --- unignore any research folder under pending/*/research ---
# allow traversal down to research
!/.agent-tasks/tasks/
!/.agent-tasks/tasks/*/
!/.agent-tasks/tasks/*/research/
!/.agent-tasks/tasks/*/research/**