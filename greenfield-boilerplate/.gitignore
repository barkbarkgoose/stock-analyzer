*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

CLAUDE.md
telemetry-id

# --- agent tasks ---
# Ignore the whole directory, but allow tracked archive/devnotes/research.
.agent-tasks/
.agent-tasks/**

!/.agent-tasks/
!/.agent-tasks/archive/
!/.agent-tasks/archive/**
!/.agent-tasks/devnotes/
!/.agent-tasks/devnotes/**
!/.agent-tasks/tasks/
!/.agent-tasks/tasks/*/
!/.agent-tasks/tasks/*/research/
!/.agent-tasks/tasks/*/research/**
