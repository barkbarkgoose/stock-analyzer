# -----------------------------------------------------------------------------
# Secrets & encrypted config
# -----------------------------------------------------------------------------
# keychain.key is the actual secret; keychain.json is an encrypted blob that is
# useless without it. Both stay out of source control. Every dev runs
# `python -m keychain init` once.
**/keychain.key
**/keychain.json

# -----------------------------------------------------------------------------
# Python / Django
# -----------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
.Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.eggs/
*.egg-info/
build/
dist/

# Virtualenv
.venv/
venv/
env/
ENV/

# Django
db.sqlite3
db.sqlite3-journal
backend/staticfiles/
backend/media/

# -----------------------------------------------------------------------------
# Environment files
# -----------------------------------------------------------------------------
# Real env files contain secrets (SECRET_KEY, etc.). Keep them local.
/backend/.env
/backend/.env.local
/backend/.env.production
/.env
/.env.local

# Template env files ARE committed (so newcomers know which keys to set).
!.env.example
!backend/.env.example
!frontend/.env.example

# -----------------------------------------------------------------------------
# Node / Vue
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vite / Nuxt build output
frontend/dist/
frontend/.vite/
frontend/.nuxt/

# Frontend env (the placeholder file is committed; real overrides are not)
frontend/.env
frontend/.env.local
frontend/.env.production
**/node_modules/

