# /etc/stonks/app.env — root-owned, mode 0600. scripts/server-setup.sh writes
# this file with fresh random secrets; edit only the "you choose" values.
# Changing POSTGRES_PASSWORD here does NOT change an existing database user's
# password, so leave it alone after the first start.

# --- Generated (keep stable; back these up in your password manager) ---------
SECRET_KEY=
SETTINGS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- You choose ---------------------------------------------------------------
ALLOWED_HOSTS=stonks.allbarker.com

# Market data: auto = Alpaca when keys are set, otherwise Yahoo.
MARKET_PROVIDER=auto
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# Seconds between paper-trading ticks during US market hours.
PAPER_TICK_INTERVAL=120
MARKET_PAPER_ENABLED=true

# Raise to 31536000 (1 year) once HTTPS has worked for a while.
SECURE_HSTS_SECONDS=3600
